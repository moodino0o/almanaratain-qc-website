APP_NAME="Al Manaratain QC Laravel Conversion"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=info

# Configure a separate Laravel database. Do not point this at the original
# application database until its schema and migration plan have been reviewed.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qc_laravel_conversion
DB_USERNAME=replace-me
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Optional comma-separated employee IDs that should always have administrator access.
QC_ADMIN_EMPLOYEE_IDS=

# Configure a Laravel filesystem disk/provider separately for uploaded files.
# Never paste credentials here; use the deployment environment's secret store.
FILESYSTEM_DISK=local

# Replit App Storage object locations; configure these through the environment.
# Uploads use direct signed URLs. File bytes do not go into PostgreSQL.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Archive retirement is restricted to administrators in these allowlists.
ARCHIVE_MANAGER_EMAILS=
ARCHIVE_MANAGER_EMPLOYEE_IDS=
