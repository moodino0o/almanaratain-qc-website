APP_NAME="Al Manaratain QC Laravel Conversion"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=info

# Configure a separate Laravel database. Do not point this at the original
# application database until its schema and migration plan have been reviewed.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qc_laravel_conversion
DB_USERNAME=replace-me
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Optional comma-separated employee IDs that should always have administrator access.
QC_ADMIN_EMPLOYEE_IDS=

# Configure a Laravel filesystem disk/provider separately for uploaded files.
# Never paste credentials here; use the deployment environment's secret store.
FILESYSTEM_DISK=local
